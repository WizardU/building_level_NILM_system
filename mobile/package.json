{
  "name": "nilm-mobile",
  "version": "1.0.0",
  "description": "Building-level NILM Uni-app mobile client",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "dev:app": "uni",
    "dev:custom": "uni -p",
    "dev:h5": "uni",
    "dev:h5:ssr": "uni --ssr",
    "build:app": "uni build",
    "build:custom": "uni build -p",
    "build:h5": "uni build",
    "build:h5:ssr": "uni build --ssr",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
