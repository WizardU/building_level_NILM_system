    "@dcloudio/uni-mp-alipay": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-mp-baidu": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-mp-jd": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-mp-kuaishou": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-mp-lark": "3.0.0-alpha-5030220261016001",
    "@dcloudio/uni-mp-qq": "3.0.0-alpha-5030220261016001",
